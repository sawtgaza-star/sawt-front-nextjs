# Sawt REST API. Read by src/lib/api/client.ts.
#
# NEXT_PUBLIC_* is inlined at BUILD time — this is a static export
# (next.config.mjs → output: 'export'), so changing it needs a rebuild, and the
# value ends up visible in the shipped JS. Never put a secret here.
#
# Copy to .env.local to point a build at another environment. The code falls
# back to the production URL below when the variable is absent.
NEXT_PUBLIC_API_BASE_URL=https://api.sawtgaza.com/api/v1

# Google reCAPTCHA v2 ("أنا لست روبوت" checkbox) — the PUBLIC site key. Read
# by src/lib/recaptcha.ts; the secret key belongs to the API only. The code
# falls back to the production key below when the variable is absent.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LcwZN4tAAAAAMpSFfoWd7ULRgC9vE5uCyFPardZ
