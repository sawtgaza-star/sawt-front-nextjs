{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/global-not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/global-not-found.css",
      "static/chunks/app/global-not-found.js"
    ],
    "/(main)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(main)/layout.css",
      "static/chunks/app/(main)/layout.js"
    ],
    "/(main)/content/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(main)/content/layout.js"
    ],
    "/(main)/content/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(main)/content/page.css",
      "static/chunks/app/(main)/content/page.js"
    ]
  }
}